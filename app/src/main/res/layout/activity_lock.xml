<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivLockIcon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:src="@android:drawable/ic_lock_lock"
        android:tint="?attr/colorPrimary"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@id/tvLockTitle"
        app:layout_constraintVertical_chainStyle="packed"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvLockTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="?attr/colorOnSurface"
        app:layout_constraintTop_toBottomOf="@id/ivLockIcon"
        app:layout_constraintBottom_toTopOf="@id/tvEnterPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvEnterPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/enter_pin"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        app:layout_constraintTop_toBottomOf="@id/tvLockTitle"
        app:layout_constraintBottom_toTopOf="@id/llPinDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

    <!-- PIN Dots -->
    <LinearLayout
        android:id="@+id/llPinDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        app:layout_constraintTop_toBottomOf="@id/tvEnterPin"
        app:layout_constraintBottom_toTopOf="@id/tvErrorPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="8dp">

        <View android:id="@+id/dot1" android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/bg_pin_dot_empty" android:layout_margin="8dp" />
        <View android:id="@+id/dot2" android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/bg_pin_dot_empty" android:layout_margin="8dp" />
        <View android:id="@+id/dot3" android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/bg_pin_dot_empty" android:layout_margin="8dp" />
        <View android:id="@+id/dot4" android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/bg_pin_dot_empty" android:layout_margin="8dp" />
        <View android:id="@+id/dot5" android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/bg_pin_dot_empty" android:layout_margin="8dp" />
        <View android:id="@+id/dot6" android:layout_width="16dp" android:layout_height="16dp"
            android:background="@drawable/bg_pin_dot_empty" android:layout_margin="8dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvErrorPin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="?attr/colorError"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/llPinDots"
        app:layout_constraintBottom_toTopOf="@id/gridPin"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- PIN Keypad -->
    <androidx.gridlayout.widget.GridLayout
        android:id="@+id/gridPin"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/tvErrorPin"
        app:layout_constraintBottom_toTopOf="@id/btnBiometric"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">
    </androidx.gridlayout.widget.GridLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBiometric"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Use Biometric"
        android:textColor="?attr/colorPrimary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="32dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
